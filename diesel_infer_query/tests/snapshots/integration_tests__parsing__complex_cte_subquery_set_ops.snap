info: "CREATE VIEW test AS WITH stage1 AS (SELECT a, b, c, d FROM sources WHERE c > 1), stage2 AS (SELECT a, b, c, d FROM other_sources WHERE c > 1), union_set AS (SELECT a, b, c, d FROM stage1 UNION SELECT a, b, c, d FROM stage2), cte_nested AS (\n                   SELECT t.a, t.b, t.c, t.d, s.col1, s.col2 FROM union_set t JOIN (SELECT col1, col2 FROM small_table LIMIT 1) s ON t.a = s.col\n               ) SELECT a, b, c, d, col1, col2 FROM cte_nested"
